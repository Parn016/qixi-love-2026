  "scenes": [
    { "n": 1, "img": "images/1.png", "lines": ["给你", "七夕 · 二〇二六"] },
    { "n": 2, "img": "images/2.png", "lines": ["以前，我总是一个人。", "不知何为理解", "不知何为付出", "不知何为责任", "更不知如何表达自己"] },
    { "n": 3, "img": "images/3.png", "lines": ["后来，我遇见了你。"] },
    { "n": 4, "img": "images/4.png", "lines": ["你那么开朗、那么热情，", "我明明感受到了你的好，", "却不知道怎么回应。", "我害怕，我躲开了。"] },
    { "n": 5, "img": "images/5.png", "lines": ["直到快失去你的那一刻，", "我才发现——"] },
    { "n": 6, "img": "images/6.png", "lines": ["我非常非常喜欢你。"] },
    { "n": 7, "img": "images/7.png", "lines": ["我知道，你走到今天，很不容易。", "你的过往你的一切，", "我都想接受。"] },
    { "n": 8, "img": "images/8.png", "lines": ["你说过的话，我一句一句都记着。"] },
    { "n": 9, "img": "images/9.png", "lines": ["所以我在认真生活：", "锻炼、护肤、学习、找副业，", "与父母老师好好相处，", "成为负责人感受担当，", "一点一点，把自己变好。"] },
    { "n": 10, "img": "images/10.png", "lines": ["不想让你操心，", "想让你放心，", "我是真的喜欢你。"] },
    { "n": 11, "img": "images/11.png", "lines": ["我怕看不懂你想要什么，", "我怕误会你的意思，", "我怕变成你的负担，", "我怕我配不上你，", "更怕永远失去了你。"] },
    { "n": 12, "img": "images/12.png", "lines": ["你的考试，一定准备得很辛苦。", "我相信，你一定可以。"] },
    { "n": 13, "img": "images/13.png", "lines": ["起那么早，别熬到那么晚。", "别贪嘴吃得太多，", "身体比什么都重要。", "你辛苦了。"] },
    { "n": 14, "img": "images/14.png", "lines": ["我不会走，", "我想留在你的内心，", "给你真诚的关爱，", "替你分担生活琐事，", "一直牵挂着你。"] },
    { "n": 15, "img": "images/15.png", "lines": ["我喜欢的是你，", "不是任何人。", "不管什么时候，我都在。"] }
  ]
}
